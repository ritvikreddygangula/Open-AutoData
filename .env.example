# Copy to .env and fill in. Never commit .env.

# Required: OpenRouter API key (https://openrouter.ai/keys)
OPEN_ROUTER=

# Optional: override any model (OpenRouter IDs). Defaults live in src/config.py.
# MODEL_CHALLENGER=z-ai/glm-5.3
# MODEL_VERIFIER=nvidia/nemotron-3-super-120b-a12b
# MODEL_WEAK=meta-llama/llama-3.2-3b-instruct
# MODEL_STRONG=deepseek/deepseek-v4.1-flash
# MODEL_JUDGE=nvidia/nemotron-3-super-120b-a12b
# MODEL_FINAL_JUDGE=qwen/qwen3.8-2.4t-a95b

# Optional: Snowflake writeback. Set SNOWFLAKE_ENABLED=1 and fill these to turn it on.
SNOWFLAKE_ENABLED=0
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=OPENAUTODATA
SNOWFLAKE_SCHEMA=PUBLIC
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
